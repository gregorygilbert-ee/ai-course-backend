meta {
  name: Create Task
  type: http
  seq: 1
}

post {
  url: {{baseUrlTasks}}/tasks
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "title": "My first task",
    "description": "This is a test task",
    "dueDate": "2025-12-31T00:00:00.000Z"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("taskId", res.body.id);
  }
}
